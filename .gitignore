[SPRINT 5] Kong Gateway manifests
cat <<'EOF' > infrastructure/k8s/kong-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kong
  namespace: infra
spec:
  replicas: 1
  selector:
    matchLabels: {app: kong}
  template:
    metadata:
      labels: {app: kong}
    spec:
      containers:
      - name: kong
        image: kong:3.4
        env:
        - name: KONG_DATABASE
          value: "off"
        - name: KONG_DECLARATIVE_CONFIG
          value: "/kong/declarative/kong.yml"
        ports:
        - containerPort: 8000
        - containerPort: 8443
EOF
echo "[CREATED] infrastructure/k8s/kong-deployment.yaml"

