from fastapi import FastAPI
from contextlib import asynccontextmanager
import structlog

@asynccontextmanager
async def lifespan(app: FastAPI):
    structlog.configure(processors=[structlog.dev.ConsoleRenderer()])
    yield
app = FastAPI(lifespan=lifespan)

@app.get("/health")
def health():
    return {"status": "ok"}
EOF
