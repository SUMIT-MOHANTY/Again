#!/bin/bash
set -e
docker build -t fintech-platform:latest .
echo "[OK] Image built"
EOF
chmod +x build.sh

cat <<'EOF' > run.sh
#!/bin/bash
set -e
docker-compose up --build
echo "[OK] Stack running"
EOF
chmod +x run.sh

cat <<'EOF' > dev.sh
#!/bin/bash
set -e
kubectl port-forward -n infra svc/kong-gateway 8080:80 &
kubectl port-forward -n keycloak svc/keycloak 8081:80 &
echo "[OK] Port-forwards active"
EOF
chmod +x dev.sh

# [FIX 3] Create working GitHub Actions pipeline
cat <<'EOF' > .github/workflows/ci.yml
name: CI/CD Pipeline
on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main ]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v4
    - name: Set up Go
      uses: actions/setup-go@v4
      with:
        go-version: '1.21'
    - name: Install dependencies
      run: |
        go mod download
        go install honnef.co/go/tools/cmd/staticcheck@latest
    - name: Run tests
      run: go test -v ./...
    - name: Run static checks
      run: staticcheck ./...
  build:
    needs: test
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v4
    - name: Build Docker image
      run: docker build -t fintech-platform:${GITHUB_SHA} .
    - name: Push to registry
      run: |
        echo "${{ secrets.GITHUB_TOKEN }}" | docker login ghcr.io -u USERNAME --password-stdin
        docker tag fintech-platform:${GITHUB_SHA} ghcr.io/USERNAME/fintech-platform:${GITHUB_SHA}
        docker push ghcr.io/USERNAME/fintech-platform:${GITHUB_SHA}
  deploy:
    needs: build
    runs-on: ubuntu-latest
    steps:
    - uses: actions/checkout@v4
    - name: Deploy with Helm
      run: |
        helm upgrade --install fintech ./helm/fintech-platform \
          --namespace production --create-namespace \
          --set image.tag=${GITHUB_SHA}
EOF

# [FIX 4] Create complete Helm chart structure
mkdir -p helm/fintech-platform/{templates,charts}
cat <<'EOF' > helm/fintech-platform/Chart.yaml
apiVersion: v2
name: fintech-platform
description: Fintech micro-services platform
type: application
version: 0.1.0
appVersion: "1.0.0"
EOF

cat <<'EOF' > helm/fintech-platform/values.yaml
replicaCount: 3
image:
  repository: fintech-platform
  tag: latest
  pullPolicy: IfNotPresent
service:
  type: ClusterIP
  port: 80
ingress:
  enabled: true
  annotations:
    kubernetes.io/ingress.class: nginx
  hosts:
    - host: api.example.com
      paths:
        - path: /
          pathType: Prefix
resources:
  limits:
    cpu: 500m
    memory: 512Mi
  requests:
    cpu: 250m
    memory: 256Mi
EOF

cat <<'EOF' > helm/fintech-platform/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Release.Name }}
  labels:
    app: {{ .Release.Name }}
spec:
  replicas: {{ .Values.replicaCount }}
  selector:
    matchLabels:
      app: {{ .Release.Name }}
  template:
    metadata:
      labels:
        app: {{ .Release.Name }}
    spec:
      containers:
      - name: {{ .Release.Name }}
        image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
        ports:
        - containerPort: 8080
        resources:
          {{- toYaml .Values.resources | nindent 10 }}
        livenessProbe:
          httpGet:
            path: /health
            port: 8080
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /ready
            port: 8080
          initialDelaySeconds: 5
          periodSeconds: 5
EOF

cat <<'EOF' > helm/fintech-platform/templates/service.yaml
apiVersion: v1
kind: Service
metadata:
  name: {{ .Release.Name }}
spec:
  selector:
    app: {{ .Release.Name }}
  ports:
  - protocol: TCP
    port: {{ .Values.service.port }}
    targetPort: 8080
  type: {{ .Values.service.type }}
EOF

cat <<'EOF' > helm/fintech-platform/templates/ingress.yaml
{{- if .Values.ingress.enabled }}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ .Release.Name }}
  annotations:
    {{- toYaml .Values.ingress.annotations | nindent 4 }}
spec:
  rules:
  {{- range .Values.ingress.hosts }}
  - host: {{ .host }}
    http:
      paths:
      {{- range .paths }}
      - path: {{ .path }}
        pathType: {{ .pathType }}
        backend:
          service:
            name: {{ $.Release.Name }}
            port:
              number: {{ $.Values.service.port }}
      {{- end }}
  {{- end }}
{{- end }}
EOF

