from fastapi import APIRouter, HTTPException, Depends
from pydantic import BaseModel
from typing import List
from ..app.oidc_service import OIDCService

router = APIRouter(prefix="/oidc", tags=["oidc"])

class TokenResponse(BaseModel):
    access_token: str
    token_type: str
    expires_in: int
    scope: str

class JWKSResponse(BaseModel):
    keys: List[dict]

@router.get("/jwks", response_model=JWKSResponse)
def get_jwks(service: OIDCService = Depends()):
    keys = service.get_public_jwks()
    return JWKSResponse(keys=keys)

@router.post("/token", response_model=TokenResponse)
def exchange_token(service: OIDCService = Depends()):
    token = service.create_access_token()
    return TokenResponse(
        access_token=token,
        token_type="Bearer",
        expires_in=3600,
        scope="read write"
    )
EOF
