cat <<'EOF' > backend/app/oidc_service.py
import json
import uuid
import time
from jwcrypto import jwk, jwt
from typing import List, Dict

class OIDCService:
    _key = jwk.JWK.generate(kty="RSA", size=2048)  # cache key

    def get_public_jwks(self) -> List[Dict]:
        return [self._key.export_public(as_dict=True)]

    def create_access_token(self) -> str:
        now = int(time.time())
        payload = {
            "iss": "http://localhost:8080",
            "sub": str(uuid.uuid4()),
            "aud": "accounts",
            "exp": now + 3600,
            "iat": now,
            "scope": "read write",
            "roles": ["user"]
        }
        token = jwt.JWT(header={"alg": "RS256"}, claims=payload)
        token.make_signed_token(self._key)
        return token.serialize()
EOF
