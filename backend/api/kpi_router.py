from fastapi import APIRouter, Depends
from sqlalchemy.orm import Session
from typing import Dict
import uuid
from backend.data.database import get_db
from backend.data.models import Policy, PremiumPayment, BankAccount
from backend.api.response import success_response

router = APIRouter(prefix="/api/v1/kpi", tags=["kpi"])

@router.get("/dashboard-cards")
async def get_kpi_cards(db: Session = Depends(get_db)) -> Dict:
    """Get real-time KPI values for dashboard cards."""
    
    # Total funds calculation
    total_funds = db.query(BankAccount).count() * 23750.50  # Mock calculation
    
    # Active policies
    active_policies = db.query(Policy).filter(Policy.status == 'active').count()
    
    # Overdue premiums (mocked for now)
    overdue_premiums = (
        db.query(PremiumPayment)
        .filter(PremiumPayment.status == 'overdue')
        .count() * 850.00
    )
    
    return success_response({
        "total_funds": round(total_funds, 2),
        "active_policies": active_policies,
        "overdue_premiums": round(overdue_premiums, 2)
    })
EOF
