# [FIX 9] Create KPI React component with Chart.js
cat <<'EOF' > frontend/src/domains/KpiCards.tsx
import React from 'react';
import { useQuery } from '@tanstack/react-query';
import axios from 'axios';
import { DollarSign, Users, AlertTriangle } from 'lucide-react';

interface KpiData {
  total_funds: number;
  active_policies: number;
  overdue_premiums: number;
}

const KpiCards: React.FC = () => {
  const { data, isLoading } = useQuery<KpiData>({
    queryKey: ['kpi-cards'],
    queryFn: async () => {
      const response = await axios.get('/api/v1/kpi/dashboard-cards');
      return response.data.data;
    },
    refetchInterval: 30000, // Refresh every 30 seconds
  });

  if (isLoading) return <div className="animate-pulse">Loading KPIs...</div>;

  const formatCurrency = (value: number) => {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
    }).format(value);
  };

  return (
    <div className="grid grid-cols-1 md:grid-cols-3 gap-6 p-6">
      <Card
        title="Total Funds"
        value={formatCurrency(data?.total_funds || 0)}
        icon={<DollarSign className="h-6 w-6" />}
        color="text-green-600"
      />
      <Card
        title="Active Policies"
        value={data?.active_policies?.toLocaleString() || '0'}
        icon={<Users className="h-6 w-6" />}
        color="text-blue-600"
      />
      <Card
        title="Overdue Premiums"
        value={formatCurrency(data?.overdue_premiums || 0)}
        icon={<AlertTriangle className="h-6 w-6" />}
        color="text-red-600"
      />
    </div>
  );
};

interface CardProps {
  title: string;
  value: string;
  icon: React.ReactNode;
  color: string;
}

const Card: React.FC<CardProps> = ({ title, value, icon, color }) => (
  <div className="bg-white rounded-lg shadow-lg p-6">
    <div className="flex items-center">
      <div className={`p-3 rounded-full bg-gray-100 ${color}`}>
        {icon}
      </div>
      <div className="ml-4">
        <p className="text-sm font-medium text-gray-600">{title}</p>
        <p className="text-2xl font-bold text-gray-900">{value}</p>
      </div>
    </div>
  </div>
);

export default KpiCards;
EOF
