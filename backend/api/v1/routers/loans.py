# backend/app/services/loan_service.py
import uuid
from decimal import Decimal
from sqlalchemy.orm import Session
from backend.data.models.loan import Loan, LoanAudit
from backend.app.services.risk_client import RiskScoreClient
from backend.data.schemas.loan_schemas import LoanRequest
from backend.app.events.kafka_producer import publish_loan_disbursed
import structlog

logger = structlog.get_logger()

class LoanService:
    def __init__(self, db: Session):
        self.db = db
        self.risk_client = RiskScoreClient()

    async def create_loan(self, user_id: uuid.UUID, request: LoanRequest) -> Loan:
        risk_score = await self.risk_client.get_score(str(user_id))
        loan = Loan(
            id=uuid.uuid4(),
            user_id=user_id,
            amount=request.amount,
            purpose=request.purpose,
            currency=request.currency,
            term_months=request.term_months,
            risk_score=Decimal(str(risk_score)),
            status="PENDING",
            approved=None
        )
        self.db.add(loan)
        self.db.commit()
        logger.bind(loan_id=str(loan.id)).info("loan_created")
        return loan

    async def approve_or_deny_loan(self, loan_id: uuid.UUID, approved: bool) -> Loan:
        loan = self.db.query(Loan).filter(Loan.id == loan_id).first()
        if not loan: raise ValueError("Loan not found")
        if loan.status != "PENDING": raise ValueError("Loan not pending")
        loan.approved = approved
        loan.status = "APPROVED" if approved else "DENIED"
        loan_audit = LoanAudit(loan_id=loan.id, action="APPROVED" if approved else "DENIED")
        self.db.add(loan_audit)
        self.db.commit()
        logger.bind(loan_id=str(loan.id), approved=approved).info("loan_decision_made")
        return loan

    async def disburse_loan(self, loan_id: uuid.UUID) -> Loan:
        loan = self.db.query(Loan).filter(Loan.id == loan_id, Loan.approved == True).first()
        if not loan: raise ValueError("Loan not found or not approved")
        loan.status = "DISBURSED"
        loan_audit = LoanAudit(loan_id=loan.id, action="DISBURSED")
        self.db.add(loan_audit)
        self.db.commit()
        await publish_loan_disbursed(loan.id, loan.amount)
        logger.bind(loan_id=str(loan.id)).info("loan_disbursed")
        return loan

    async def record_repayment(self, loan_id: uuid.UUID, user_id: uuid.UUID, amount: Decimal):
        loan = self.db.query(Loan).filter(Loan.id == loan_id, Loan.user_id == user_id).first()
        if not loan: raise ValueError("Loan not found")
        audit = LoanAudit(loan_id=loan_id, action=f"REPAYMENT {amount}")
        self.db.add(audit)
        # TODO: check if fully repaid to update status
        self.db.commit()
        logger.bind(loan_id=str(loan_id), amount=amount).info("loan_repaid")
        return audit
EOF

