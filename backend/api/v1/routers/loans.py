from uuid import UUID
from fastapi import APIRouter, Depends, HTTPException, Request
from sqlalchemy.orm import Session
from backend.data.database import get_db
from backend.app.services.loan_service import LoanService
from backend.data.models.user import User
from backend.api.v1.dependencies.auth import get_current_user
from backend.data.schemas.loan_schemas import LoanRequest, LoanResponse, RepaymentRequest, RepaymentResponse
from typing import Optional

router = APIRouter(prefix="/loans", tags=["loans"])

@router.post("/", response_model=dict)
async def create_loan(
    request: Request,
    loan_request: LoanRequest,
    current_user: User = Depends(get_current_user),
    db: Session = Depends(get_db)
):
    loan_service = LoanService(db)
    loan = await loan_service.create_loan(current_user.id, loan_request)
    return {
        "status": "success",
        "data": LoanResponse.from_orm(loan),
        "trace_id": str(request.state.trace_id)
    }

@router.patch("/{loan_id}/approve", response_model=dict)
async def approve_loan(
    request: Request,
    loan_id: UUID,
    payload: dict,
    current_user: User = Depends(get_current_user),
    db: Session = Depends(get_db)
):
    if current_user.role != 'admin':
        raise HTTPException(403, "Admin required")
    loan_service = LoanService(db)
    loan = await loan_service.approve_or_deny_loan(loan_id, payload["approved"])
    return {
        "status": "success",
        "data": LoanResponse.from_orm(loan),
        "trace_id": str(request.state.trace_id)
    }

@router.patch("/{loan_id}/disburse", response_model=dict)
async def disburse_loan(
    request: Request,
    loan_id: UUID,
    current_user: User = Depends(get_current_user),
    db: Session = Depends(get_db)
):
    if current_user.role != 'admin':
        raise HTTPException(403, "Admin required")
    loan_service = LoanService(db)
    loan = await loan_service.disburse_loan(loan_id)
    return {
        "status": "success",
        "data": LoanResponse.from_orm(loan),
        "trace_id": str(request.state.trace_id)
    }

@router.post("/{loan_id}/repayment", response_model=dict)
async def repay_loan(
    request: Request,
    loan_id: UUID,
    repayment: RepaymentRequest,
    current_user: User = Depends(get_current_user),
    db: Session = Depends(get_db)
):
    loan_service = LoanService(db)
    repayment_record = await loan_service.record_repayment(loan_id, current_user.id, repayment.amount)
    return {
        "status": "success",
        "data": RepaymentResponse(
            loan_id=loan_id,
            repayment_id=repayment_record.id,
            amount=repayment_record.amount,
            paid_at=repayment_record.created_at
        ),
        "trace_id": str(request.state.trace_id)
    }
EOF

