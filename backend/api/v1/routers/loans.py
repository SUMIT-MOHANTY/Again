# backend/app/events/kafka_producer.py
from confluent_kafka import Producer
from datetime import datetime
from backend.app.config.env import KAFKA_BROKER
from backend.app.events.loan_events import LoanDisbursed
import json
import uuid

producer = Producer({'bootstrap.servers': KAFKA_BROKER})

async def publish_loan_disbursed(loan_id: uuid.UUID, amount: Decimal):
    event = LoanDisbursed(
        loan_id=loan_id,
        amount=amount,
        timestamp=datetime.utcnow()
    )
    producer.produce("loan_disbursed", json.dumps(event.dict()).encode())
    producer.flush()
EOF

