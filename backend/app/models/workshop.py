cat <<'EOF' > /workspace/frontend/src/api/workshop.ts
import type { Story, StoryCreate } from '../types/Workshop';

const API_BASE = '/api/workshop';

export async function fetchStories(): Promise<Story[]> {
  const resp = await fetch(`${API_BASE}/stories`);
  if (!resp.ok) throw new Error('Failed to fetch stories');
  return resp.json();
}

export async function addStory(story: StoryCreate): Promise<Story> {
  const resp = await fetch(`${API_BASE}/stories`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(story),
  });
  if (!resp.ok) throw new Error('Failed to add story');
  return resp.json();
}

export async function sendReview(storyIds: number[]): Promise<{ status: string }> {
  const resp = await fetch(`${API_BASE}/review`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ story_ids: storyIds }),
  });
  if (!resp.ok) throw new Error('Failed to send review');
  return resp.json();
}
EOF

