from typing import List
from .models.workshop import Story, StoryCreate

_stories: List[Story] = []
_next_id: int = 1

def get_all_stories() -> List[Story]:
    return list(_stories)

def add_story(story_create: StoryCreate) -> Story:
    global _next_id
    story = Story(story_id=_next_id, **story_create.dict())
    _next_id += 1
    _stories.append(story)
    return story

