cat <<'EOF' > /workspace/frontend/src/components/WorkshopBoard.tsx
import React, { useEffect, useState } from 'react';
import type { Story, StoryCreate } from '../types/Workshop';
import { fetchStories, addStory, sendReview } from '../api/workshop';

const WorkshopBoard: React.FC = () => {
  const [stories, setStories] = useState<Story[]>([]);
  const [form, setForm] = useState<StoryCreate>({ title: '', acceptance_criteria: '', priority_vote: 1 });

  useEffect(() => {
    loadStories();
  }, []);

  const loadStories = async () => {
    const data = await fetchStories();
    setStories(data);
  };

  const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {
    const { name, value } = e.target;
    setForm(prev => ({ ...prev, [name]: name === 'priority_vote' ? Number(value) : value }));
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    const created = await addStory(form);
    setStories(prev => [...prev, created]);
    setForm({ title: '', acceptance_criteria: '', priority_vote: 1 });
  };

  const handleReview = async () => {
    const ids = stories.map(s => s.story_id);
    await sendReview(ids);
    alert('Review request sent');
  };

  return (
    <div>
      <h2>Workshop Stories</h2>
      <ul>
        {stories.map(s => (
          <li key={s.story_id}>
            <strong>{s.title}</strong> (Priority: {s.priority_vote})
            <p>{s.acceptance_criteria}</p>
          </li>
        ))}
      </ul>

      <h3>Add New Story</h3>
      <form onSubmit={handleSubmit}>
        <input name="title" placeholder="Title" value={form.title} onChange={handleChange} required />
        <textarea
          name="acceptance_criteria"
          placeholder="Acceptance Criteria"
          value={form.acceptance_criteria}
          onChange={handleChange}
          required
        />
        <input
          name="priority_vote"
          type="number"
          min={1}
          max={5}
          value={form.priority_vote}
          onChange={handleChange}
          required
        />
        <button type="submit">Add Story</button>
      </form>

      <button onClick={handleReview} disabled={stories.length === 0}>
        Send for Review
      </button>
    </div>
  );
};

export default WorkshopBoard;
EOF

