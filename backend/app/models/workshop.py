from fastapi import APIRouter, HTTPException
from typing import List, Dict, Any
from ..models.workshop import Story, StoryCreate
from ..database import get_all_stories, add_story, send_review_request

router = APIRouter()

@router.get("/stories", response_model=List[Story])
def get_stories():
    return get_all_stories()

@router.post("/stories", response_model=Story)
def create_story(story: StoryCreate):
    return add_story(story)

@router.post("/review")
def review(payload: Dict[str, Any]):
    story_ids = payload.get("story_ids")
    if not isinstance(story_ids, list):
        raise HTTPException(status_code=400, detail="story_ids must be a list")
    send_review_request(story_ids)
    return {"status": "review_sent"}
EOF

