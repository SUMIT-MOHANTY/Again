"""AWS Secrets Manager wrapper.

Provides a simple interface to retrieve JSON‑encoded secrets.
"""
import json
import logging
from typing import Dict, Any

import boto3
from botocore.exceptions import BotoCoreError, ClientError

logger = logging.getLogger(__name__)


class SecretsManager:
    """Thin wrapper around boto3 Secrets Manager client."""

    def __init__(self, region: str = "us-east-1"):
        """Create a SecretsManager for the given AWS region."""
        self.region = region
        self.client = boto3.client("secretsmanager", region_name=self.region)

    def get_secret(self, secret_name: str) -> Dict[str, Any]:
        """Retrieve a secret and return its JSON payload as a dict.

        Args:
            secret_name: Name or ARN of the secret.

        Returns:
            Parsed JSON secret.

        Raises:
            RuntimeError: If the secret cannot be retrieved or parsed.
        """
        try:
            response = self.client.get_secret_value(SecretId=secret_name)
            secret_str = response.get("SecretString")
            if not secret_str:
                raise RuntimeError(f"Secret {secret_name} has no string value")
            return json.loads(secret_str)
        except (BotoCoreError, ClientError) as exc:
            logger.error("Failed to retrieve secret %s: %s", secret_name, exc)
            raise RuntimeError(f"Unable to retrieve secret {secret_name}") from exc
        except json.JSONDecodeError as exc:
            logger.error("Secret %s is not valid JSON: %s", secret_name, exc)
            raise RuntimeError(f"Secret {secret_name} is not valid JSON") from exc
