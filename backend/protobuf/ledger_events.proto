# Create transaction outbox pattern implementation
cat <<'EOF' > backend/ledger_service/outbox/outbox_service.py
import json
import asyncio
from datetime import datetime
from typing import Dict, Any
from sqlalchemy import create_engine, text
from sqlalchemy.orm import sessionmaker

class OutboxService:
    def __init__(self, database_url: str):
        self.engine = create_engine(database_url)
        self.SessionLocal = sessionmaker(bind=self.engine)
        
    def save_event(self, event_type: str, event_payload: Dict[str, Any]) -> int:
        """Save event to outbox table and return outbox ID"""
        with self.SessionLocal() as session:
            result = session.execute(
                text("""
                    INSERT INTO ledger_outbox (event_type, event_payload)
                    VALUES (:event_type, :event_payload)
                    RETURNING id
                """),
                {
                    "event_type": event_type,
                    "event_payload": json.dumps(event_payload)
                }
            )
            session.commit()
            return result.scalar()
    
    def get_unprocessed_events(self, limit: int = 100):
        """Get unprocessed outbox events"""
        with self.SessionLocal() as session:
            result = session.execute(
                text("""
                    SELECT id, event_type, event_payload
                    FROM ledger_outbox
                    WHERE processed = FALSE
                    ORDER BY created_at ASC
                    LIMIT :limit
                """),
                {"limit": limit}
            )
            return result.fetchall()
    
    def mark_processed(self, outbox_id: int):
        """Mark outbox event as processed"""
        with self.SessionLocal() as session:
            session.execute(
                text("""
                    UPDATE ledger_outbox
                    SET processed = TRUE, processed_at = :now
                    WHERE id = :outbox_id
                """),
                {
                    "outbox_id": outbox_id,
                    "now": datetime.utcnow()
                }
            )
            session.commit()
EOF
