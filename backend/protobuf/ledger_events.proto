# Create idempotent producer with transaction pattern
cat <<'EOF' > backend/ledger_service/producer/ledger_producer.py
import asyncio
import logging
from typing import Dict, Any
from kafka import KafkaProducer
from kafka.errors import KafkaError
from backend.ledger_service.producer.kafka_config import LedgerKafkaConfig
from backend.ledger_service.outbox.outbox_service import OutboxService

logger = logging.getLogger(__name__)

class LedgerProducer:
    def __init__(self, database_url: str):
        self.kafka_config = LedgerKafkaConfig()
        self.producer = self.kafka_config.create_producer()
        self.outbox = OutboxService(database_url)
        self.topics = {
            "TRANSFER": "ledger-transfer-events",
            "LOAN": "ledger-loan-events", 
            "POLICY": "ledger-policy-events"
        }
    
    def publish_event(self, event_type: str, event_payload: Dict[str, Any]) -> bool:
        """Publish event with idempotency and transaction outbox pattern"""
        try:
            # Step 1: Save to outbox in transactional way
            outbox_id = self.outbox.save_event(event_type, event_payload)
            
            # Step 2: Send to Kafka
            topic = self.topics.get(event_type.upper())
            if not topic:
                raise ValueError(f"Unknown event type: {event_type}")
            
            # Use outbox_id as key for idempotency
            future = self.producer.send(
                topic=topic,
                key=str(outbox_id),
                value=event_payload
            )
            
            # Wait for confirmation
            future.get(timeout=30)
            
            # Step 3: Mark processed in outbox
            self.outbox.mark_processed(outbox_id)
            logger.info(f"Successfully published {event_type} with outbox_id {outbox_id}")
            return True
            
        except KafkaError as e:
            logger.error(f"Kafka error publishing {event_type}: {e}")
            # Event remains in outbox for retry
            return False
        except Exception as e:
            logger.error(f"Unexpected error publishing {event_type}: {e}")
            return False
    
    def reprocess_outbox(self):
        """Reprocess unprocessed outbox events during recovery"""
        unprocessed = self.outbox.get_unprocessed_events()
        logger.info(f"Reprocessing {len(unprocessed)} unprocessed outbox events")
        
        for outbox_event in unprocessed:
            try:
                self.producer.send(
                    topic=self.topics.get(outbox_event.event_type.upper()),
                    key=str(outbox_event.id),
                    value=outbox_event.event_payload
                ).get(timeout=30)
                
                self.outbox.mark_processed(outbox_event.id)
                logger.info(f"Successfully reprocessed outbox_id {outbox_event.id}")
            except Exception as e:
                logger.error(f"Failed to reprocess outbox_id {outbox_event.id}: {e}")
EOF
