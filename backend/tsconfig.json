import express from 'express';
import { loanService } from '../services/loanService';

const router = express.Router();

// POST /loans/apply
router.post('/apply', async (req, res) => {
  try {
    const { amount, term, purpose, personalInfo } = req.body;
    
    if (!amount || !term || !purpose) {
      return res.status(400).json({ error: 'Missing required fields' });
    }
    
    const loan = await loanService.createLoan({ amount, term, purpose, personalInfo });
    res.status(201).json(loan);
  } catch (error) {
    res.status(500).json({ error: 'Loan application failed' });
  }
});

// POST /loans/schedule
router.post('/schedule', async (req, res) => {
  try {
    const { loanId } = req.body;
    const schedule = await loanService.getSchedule(loanId);
    res.json(schedule);
  } catch (error) {
    res.status(500).json({ error: 'Schedule generation failed' });
  }
});

export { router as loansRouter };
