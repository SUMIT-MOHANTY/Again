import express from 'express';
import { transferService } from '../services/transferService';

const router = express.Router();

// POST /dashboard/banking/transfer
router.post('/transfer', async (req, res) => {
  try {
    const { fromAccount, toAccount, amount, currency = 'USD' } = req.body;
    
    if (!fromAccount || !toAccount || !amount) {
      return res.status(400).json({ error: 'Missing required fields' });
    }
    
    const result = await transferService.createTransfer({ fromAccount, toAccount, amount, currency });
    res.json(result);
  } catch (error) {
    res.status(500).json({ error: 'Transfer failed' });
  }
});

export { router as bankingRouter };
