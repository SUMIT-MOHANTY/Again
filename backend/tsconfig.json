cat <<'EOF' > frontend/src/pages/loans/Schedule.tsx
import React, { useState, useEffect } from 'react';

export default function LoanSchedule() {
  const [schedule, setSchedule] = useState<any>(null);
  const [loanId] = useState('loan_123'); // Mock loan ID

  useEffect(() => {
    fetchSchedule();
    
    // Real-time updates via SSE
    const eventSource = new EventSource('/api/loans/events');
    eventSource.onmessage = (event) => {
      const data = JSON.parse(event.data);
      if (data.type === 'loan-update') {
        fetchSchedule();
      }
    };
    
    return () => eventSource.close();
  }, []);

  const fetchSchedule = async () => {
    const response = await fetch('/api/loans/schedule', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ loanId })
    });
    const data = await response.json();
    setSchedule(data);
  };

  if (!schedule) return <div>Loading...</div>;

  return (
    <div>
      <h1>Loan Schedule</h1>
      {schedule.payments.map((payment: any) => (
        <div key={payment.month}>
          Month {payment.month}: ${payment.amount} (Due: {payment.dueDate})
        </div>
      ))}
    </div>
  );
}
