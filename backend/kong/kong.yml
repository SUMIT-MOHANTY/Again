_format_version: "3.0"
_transform: true

services:
  - name: banking-service
    url: http://go-bank:8080
    routes:
      - name: banking-route
        paths:
          - /api/v1/banking
        strip_path: true
        methods: ["GET", "POST", "PUT", "DELETE"]
    plugins:
      - name: rate-limiting
        config:
          minute: 100
          hour: 1000
          day: 10000
          policy: local
      - name: cors
        config:
          origins: ["*"]
          methods: ["GET", "POST", "PUT", "PATCH", "DELETE"]
          headers: ["Accept", "Accept-Version", "Content-Length", "Content-MD5", "Content-Type", "Date", "Authorization"]

  - name: insurance-service
    url: http://go-insur:8080
    routes:
      - name: insurance-route
        paths:
          - /api/v1/insurance
        strip_path: true
        methods: ["GET", "POST"]
    plugins:
      - name: rate-limiting
        config:
          minute: 50
          hour: 500
          day: 5000
          policy: local

  - name: ledger-service
    url: http://go-ledger:8080
    routes:
      - name: ledger-route
        paths:
          - /api/v1/ledger
        strip_path: true
    plugins:
      - name: rate-limiting
        config:
          minute: 200
          hour: 2000
          policy: local

  - name: dashboard-service
    url: http://go-dash:8080
    routes:
      - name: dashboard-route
        paths:
          - /api/v1/dashboard
        strip_path: true
    plugins:
      - name: rate-limiting
        config:
          minute: 20
          hour: 200
          policy: local
          authenticated_groups: ["admins"]

  - name: auth-service
    url: http://keycloak:8080
    routes:
      - name: auth-route
        paths:
          - /auth
        strip_path: false

upstreams:
  - name: go-bank
    targets:
      - target: go-bank.banking.svc.cluster.local:8080
        weight: 100
  - name: go-insur
    targets:
      - target: go-insur.insurance.svc.cluster.local:8080
        weight: 100
  - name: go-ledger
    targets:
      - target: go-ledger.finance.svc.cluster.local:8080
        weight: 100
  - name: go-dash
    targets:
      - target: go-dash.operations.svc.cluster.local:8080
        weight: 100

plugins:
  - name: oidc
    route: banking-route
    config:
      client_id: fintech-platform
      client_secret: ${CLIENT_SECRET}
      discovery: http://keycloak.auth.svc.cluster.local:8080/auth/realms/fintech/.well-known/openid-configuration
      introspection_endpoint: http://keycloak.auth.svc.cluster.local:8080/auth/realms/fintech/protocol/openid-connect/token/introspect
      bearer_only: "yes"
      realm: fintech
EOF

# [FIX 3] Create Kong Ingress configuration
cat << 'EOF' > infra/manifests/infra/kong/ingress.yml
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: fintech-ingress
  namespace: infra
  annotations:
    kubernetes.io/ingress.class: kong
    konghq.com/plugins: rate-limiting,cors
spec:
  tls:
  - hosts:
    - api.fintech.com
    secretName: fintech-tls
  rules:
  - host: api.fintech.com
    http:
      paths:
      - path: /api/v1(/|$)(.*)
        pathType: ImplementationSpecific
        backend:
          service:
            name: kong-proxy
            port:
              number: 8000
EOF

# [FIX 4] Create Kong deployment YAML
cat << 'EOF' > infra/manifests/infra/kong/deployment.yml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kong-gateway
  namespace: infra
  labels:
    app: kong-gateway
spec:
  replicas: 3
  selector:
    matchLabels:
      app: kong-gateway
  template:
    metadata:
      labels:
        app: kong-gateway
    spec:
      containers:
      - name: kong
        image: kong:3.5
        ports:
        - containerPort: 8000
          name: proxy
        - containerPort: 8443
          name: proxy-ssl
        - containerPort: 8001
          name: admin
        - containerPort: 8444
          name: admin-ssl
        - containerPort: 9542
          name: metrics
        env:
        - name: KONG_DATABASE
          value: "off"
        - name: KONG_DECLARATIVE_CONFIG
          value: "/kong/declarative/kong.yml"
        - name: KONG_PROXY_ACCESS_LOG
          value: "/dev/stdout"
        - name: KONG_ADMIN_ACCESS_LOG
          value: "/dev/stdout"
        - name: KONG_PROXY_ERROR_LOG
          value: "/dev/stderr"
        - name: KONG_ADMIN_ERROR_LOG
          value: "/dev/stderr"
        - name: KONG_ADMIN_LISTEN
          value: "0.0.0.0:8001, 0.0.0.0:8444 ssl"
        - name: KONG_STATUS_LISTEN
          value: "0.0.0.0:8100"
        volumeMounts:
        - name: kong-config
          mountPath: /kong/declarative
        livenessProbe:
          httpGet:
            path: /status
            port: 8100
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /status
            port: 8100
          initialDelaySeconds: 15
          periodSeconds: 10
      volumes:
      - name: kong-config
        configMap:
          name: kong-config
      restartPolicy: Always
---
apiVersion: v1
kind: Service
metadata:
  name: kong-proxy
  namespace: infra
spec:
  type: ClusterIP
  ports:
  - name: http
    port: 8000
    targetPort: 8000
  - name: https
    port: 8443
    targetPort: 8443
  selector:
    app: kong-gateway
---
apiVersion: v1
kind: Service
metadata:
  name: kong-admin
  namespace: infra
spec:
  type: ClusterIP
  ports:
  - name: admin
    port: 8001
    targetPort: 8001
  selector:
    app: kong-gateway
EOF

# [FIX 5] Create Kong ConfigMap
cat << 'EOF' > infra/manifests/infra/kong/configmap.yml
apiVersion: v1
kind: ConfigMap
metadata:
  name: kong-config
  namespace: infra
data:
  kong.yml: |
    _format_version: "3.0"
    _transform: true
    
    services:
      - name: wildcard
        url: http://kong-service:8080
        routes:
          - name: catchall
            paths:
              - /api
        plugins:
          - name: request-termination
            config:
              status_code: 404
              message: "API route not found. Please use correct versioned endpoints."
EOF

# [FIX 6] Create Kong rate limiting plugin configuration
cat << 'EOF' > backend/kong/rate-limiting-plugin.lua
local kong = kong
local ngx = ngx
local timestamp = require "kong.tools.timestamp"
local redis = require "resty.redis"
local _M = {}

function _M.access(conf)
    local redis_client = redis:new()
    redis_client:set_timeout(1000) -- 1 second
    
    local ok, err = redis_client:connect(os.getenv("REDIS_HOST") or "redis.infra.svc.cluster.local", 6379)
    if not ok then
        kong.log.err("failed to connect to Redis: ", err)
        return kong.response.exit(500, { message = "Rate limiting service unavailable" })
    end
    
    local key = "rate_limit:" .. ng.var.remote_addr
    local current = tonumber(redis_client:get(key) or 0)
    
    if current >= conf.limit then
        kong.response.exit(429, { message = "Rate limit exceeded" })
    end
    
    redis_client:incr(key)
    redis_client:expire(key, conf.window)
end

return _M
EOF

