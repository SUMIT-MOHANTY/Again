import uuid
from fastapi import Request, Response
from starlette.middleware.base import BaseHTTPMiddleware
from fastapi import Request

class CorrelationIdMiddleware(BaseHTTPMiddleware):
    async def dispatch(self, request: Request, call_next):
        corr_id = request.headers.get("X-Correlation-ID") or str(uuid.uuid4())
        response = await call_next(request)
        response.headers["X-Correlation-ID"] = corr_id
        return response
EOF

[FIX 4] Create audit logging middleware to Loki
cat <<'EOF' > backend/middleware/audit_logging.py
import logging
import json
from fastapi import Request
from fastapi.responses import Response
from starlette.middleware.base import BaseHTTPMiddleware
from .exception_handler import mask_pii

class AuditLoggingMiddleware(BaseHTTPMiddleware):
    async def dispatch(self, request: Request, call_next):
        logger = logging.getLogger("app.audit")
        
        body = await request.body()
        masked_body = mask_pii(body.decode() if body else "")
        
        response = await call_next(request)
        
        if hasattr(response, "body"):
            response_body = mask_pii(response.body.decode())
        else:
            response_body = "N/A"
            
        audit_log = {
            "method": request.method,
            "path": mask_pii(str(request.url)),
            "status": response.status_code,
            "request_body": masked_body,
            "response_body": response_body
        }
        logger.info("audit", extra=audit_log)
        return response
EOF

