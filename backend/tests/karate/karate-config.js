describe('Loan Application Flow', () => {
  beforeEach(() => {
    cy.login()
    cy.intercept('POST', '/api/v1/loans', {
      statusCode: 200,
      body: {
        status: 'success',
        data: {
          id: 'loan-123',
          amount: 5000,
          interest_rate: 5.5,
          term_months: 24,
          status: 'pending'
        },
