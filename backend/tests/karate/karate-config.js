# Create transfer.cy.ts
cat <<'EOF' > frontend/cypress/e2e/transfer.cy.ts
describe('Money Transfer Flow', () => {
  beforeEach(() => {
    cy.login()
    cy.intercept('POST', '/api/v1/transfers', {
      statusCode: 200,
      body: {
        status: 'success',
        data: {
          id: 'transfer-123',
          source_account_id: 'acc-123',
          target_account_id: 'acc-456',
          amount: 100,
          currency: 'USD',
          status: 'pending'
        },
        trace_id: 'mock-trace-id'
      }
    }).as('createTransfer')
  })

  it('creates a successful transfer', () => {
    cy.visit('/banking/transfers')
    cy.get('[data-cy=new-transfer-button]').click()
    
    cy.get('[data-cy=source-account]').select('acc-123')
    cy.get('[data-cy=target-account]').type('acc-456')
    cy.get('[data-cy=amount]').type('100')
    cy.get('[data-cy=currency]').select('USD')
    cy.get('[data-cy=description]').type('Test transfer')
    
    cy.get('[data-cy=submit-transfer]').click()
    
    cy.wait('@createTransfer')
    cy.contains('Transfer submitted successfully').should('be.visible')
    cy.url().should('include', '/banking/transfers')
  })

  it('shows error for insufficient funds', () => {
    cy.intercept('POST', '/api/v1/transfers', {
      statusCode: 400,
      body: {
        status: 'error',
        detail: 'Insufficient funds',
        trace_id: 'mock-trace-id'
      }
    }).as('transferError')
    
    cy.createTransfer({
      source_account_id: 'acc-123',
      target_account_id: 'acc-456',
      amount: 10000,
      currency: 'USD'
    })
    
    cy.wait('@transferError')
    cy.contains('Insufficient funds').should('be.visible')
  })
})
EOF

