cat <<'EOF' > frontend/cypress/support/commands.ts
declare global {
  namespace Cypress {
    interface Chainable {
      login(): Chainable<void>
      createTransfer(data: any): Chainable<void>
      createLoan(data: any): Chainable<void>
      createClaim(data: any): Chainable<void>
    }
  }
}

Cypress.Commands.add('login', () => {
  cy.visit('/login')
  cy.get('[data-cy=email-input]').type('test@user.com')
  cy.get('[data-cy=password-input]').type('Test123!')
  cy.get('[data-cy=login-button]').click()
  cy.wait('@login')
})

Cypress.Commands.add('createTransfer', (data) => {
  cy.visit('/banking/transfers/new')
  cy.get('[data-cy=source-account]').select(data.source_account_id)
  cy.get('[data-cy=target-account]').type(data.target_account_id)
  cy.get('[data-cy=amount]').type(data.amount)
  cy.get('[data-cy=currency]').select(data.currency)
  cy.get('[data-cy=submit-transfer]').click()
})

Cypress.Commands.add('createLoan', (data) => {
  cy.visit('/banking/loans/new')
  cy.get('[data-cy=loan-amount]').type(data.amount)
  cy.get('[data-cy=interest-rate]').type(data.interest_rate)
  cy.get('[data-cy=term-months]').type(data.term_months)
  cy.get('[data-cy=submit-loan]').click()
})

Cypress.Commands.add('createClaim', (data) => {
  cy.visit('/insurance/claims/new')
  cy.get('[data-cy=policy-id]').select(data.policy_id)
  cy.get('[data-cy=incident-date]').type(data.incident_dt)
  cy.get('[data-cy=incident-amount]').type(data.incident_amount)
  cy.get('[data-cy=description]').type(data.description)
  cy.get('[data-cy=submit-claim]').click()
})
