-- Core fintech platform schema
CREATE SCHEMA IF NOT EXISTS fintech;

-- Users table (managed by Keycloak, replicated here)
CREATE TABLE fintech.users (
    user_id UUID PRIMARY KEY,
    email VARCHAR(255) UNIQUE NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Accounts table
CREATE TABLE fintech.accounts (
    account_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL REFERENCES fintech.users(user_id),
    account_number VARCHAR(20) UNIQUE NOT NULL,
    balance DECIMAL(15,2) NOT NULL DEFAULT 0,
    currency VARCHAR(3) NOT NULL DEFAULT 'USD',
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    CONSTRAINT positive_balance CHECK (balance >= 0)
);

-- Transactions table
CREATE TABLE fintech.transactions (
    transaction_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    from_account_id UUID REFERENCES fintech.accounts(account_id),
    to_account_id UUID REFERENCES fintech.accounts(account_id),
    amount DECIMAL(15,2) NOT NULL,
    transaction_ref VARCHAR(255),
    ledger_hash VARCHAR(64),
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    CONSTRAINT positive_amount CHECK (amount > 0)
);

-- Loans table
CREATE TABLE fintech.loans (
    loan_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL REFERENCES fintech.users(user_id),
    loan_number VARCHAR(20) UNIQUE NOT NULL,
    principal DECIMAL(15,2) NOT NULL,
    interest_rate DECIMAL(5,4) NOT NULL,
    term_months INTEGER NOT NULL,
    status VARCHAR(20) NOT NULL DEFAULT 'PENDING',
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    CONSTRAINT positive_principal CHECK (principal > 0)
);

-- Policies table
CREATE TABLE fintech.policies (
    policy_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL REFERENCES fintech.users(user_id),
    policy_number VARCHAR(20) UNIQUE NOT NULL,
    premium DECIMAL(10,2) NOT NULL,
    status VARCHAR(20) NOT NULL DEFAULT 'ACTIVE',
    next_due_at TIMESTAMP WITH TIME ZONE NOT NULL,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    CONSTRAINT positive_premium CHECK (premium > 0)
);

-- Create indexes for performance
CREATE INDEX idx_accounts_user_id ON fintech.accounts(user_id);
CREATE INDEX idx_transactions_from_account ON fintech.transactions(from_account_id);
CREATE INDEX idx_transactions_to_account ON fintech.transactions(to_account_id);
CREATE INDEX idx_loans_user_id ON fintech.loans(user_id);
CREATE INDEX idx_policies_user_id ON fintech.policies(user_id);
CREATE INDEX idx_policies_next_due ON fintech.policies(next_due_at) WHERE status = 'ACTIVE';
EOF
printf '[CREATED] backend/migrations/001_create_base_schema.sql\n'
[ -f backend/migrations/001_create_base_schema.sql ] && printf '[CHECK] PASS schema file created\n'

