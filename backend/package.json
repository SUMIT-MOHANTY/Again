cat <<'EOF' > backend/src/routes/auth.ts
import { Router } from 'express';
import speakeasy from 'speakeasy';
import QRCode from 'qrcode';
import bcrypt from 'bcryptjs';
import jwt from 'jsonwebtoken';
import Joi from 'joi';
import { pool } from '../db/pool.js';

export const authRouter = Router();

authRouter.post('/register', async (req, res) => {
  const schema = Joi.object({
    email: Joi.string().email().required(),
    password: Joi.string().min(8).required()
  });
  const { error } = schema.validate(req.body);
  if (error) return res.status(400).json({ error: error.message });
  const { email, password } = req.body;
  const hashed = await bcrypt.hash(password, 10);
  try {
    await pool.query('INSERT INTO app_user (email, password) VALUES ($1, $2)', [email, hashed]);
    res.status(201).end();
  } catch (_) { return res.status(409).json({ error: 'Email exists' }); }
});

authRouter.post('/login', async (req, res) => {
  const { email, password, totpToken } = req.body;
  const { rows } = await pool.query('SELECT * FROM app_user WHERE email=$1', [email]);
  if (!rows[0] || !await bcrypt.compare(password, rows[0].password))
    return res.status(401).json({ error: 'Invalid credentials' });
  if (!rows[0].mfa_secret) return res.json({ mfa_pending: false, token: jwt.sign({ id: rows[0].id }, process.env.JWT_SECRET!) });
  const verified = speakeasy.totp.verify({ secret: rows[0].mfa_secret, encoding: 'base32', token: totpToken, window: 2 });
  if (!verified) return res.status(401).json({ error: 'Invalid 2FA token' });
  res.json({ mfa_pending: false, token: jwt.sign({ id: rows[0].id }, process.env.JWT_SECRET!) });
});

authRouter.post('/mfa/setup', async (req, res) => {
  const secret = speakeasy.generateSecret({ name: 'Corp Portal' });
  const qr = await QRCode.toDataURL(secret.otpauth_url!);
  res.json({ secret: secret.base32, qr });
});

authRouter.post('/mfa/confirm', async (req, res) => {
  const { userId, secret, token } = req.body;
  const verified = speakeasy.totp.verify({ secret, encoding: 'base32', token, window: 2 });
  if (!verified) return res.status(400).json({ error: 'Invalid token' });
  await pool.query('UPDATE app_user SET mfa_secret=$1 WHERE id=$2', [secret, userId]);
  res.status(204).end();
});
EOF
