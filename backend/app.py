echo "[FIX 7] creating scheduler service"
cat <<'EOF' > backend/app/scheduler.py
import asyncio
from datetime import datetime, timedelta
from typing import List
from sqlalchemy.orm import Session
from data.database import SessionLocal
from data.models import Premium
import logging

logger = logging.getLogger(__name__)

class PremiumScheduler:
    def __init__(self):
        self.running = False
        
    async def start(self):
        self.running = True
        logger.info("Premium scheduler started")
        while self.running:
            await self.scan_and_process()
            await asyncio.sleep(60)  # Run every minute
            
    async def scan_and_process(self):
        db = SessionLocal()
        try:
            now = datetime.utcnow()
            due_premiums = db.query(Premium).filter(
                Premium.due_date <= now,
                Premium.is_paid == False,
                Premium.retry_count < 3
            ).all()
            
            for premium in due_premiums:
                await self.attempt_transfer(premium, db)
        finally:
            db.close()
            
    async def attempt_transfer(self, premium: Premium, db: Session):
        try:
            logger.info(f"Processing payment for premium {premium.id}")
            # Simulate transfer attempt
            premium.is_paid = True
            db.commit()
            logger.info(f"Payment success for premium {premium.id}")
        except Exception as e:
            premium.retry_count += 1
            db.commit()
            logger.error(f"Payment failed for premium {premium.id}: {str(e)}")
            
    def stop(self):
        self.running = False
EOF
