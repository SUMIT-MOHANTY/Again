from fastapi import APIRouter, Depends
from sqlalchemy.orm import Session
from data.database import SessionLocal
from data.models import Premium
from pydantic import BaseModel
from typing import List
from datetime import datetime
import uuid

router = APIRouter(prefix="/premiums", tags=["premiums"])

class PremiumResponse(BaseModel):
    id: str
    user_id: str
    amount_cents: int
    due_date: datetime
    is_paid: bool
    
    class Config:
        orm_mode = True

def get_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()

@router.get("/due", response_model=dict)
async def get_due_premiums(db: Session = Depends(get_db)):
    premiums = db.query(Premium).filter(Premium.is_paid == False).all()
    return {"status": "success", "data": [PremiumResponse.from_orm(p) for p in premiums], "trace_id": str(uuid.uuid4())}
EOF
