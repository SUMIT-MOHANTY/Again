from fastapi import APIRouter, HTTPException
from src.ledger_service.models.transaction import TransactionRequest, TransactionResponse
from src.ledger_service.services.fabric_service import FabricService

router = APIRouter()
fabric_service = FabricService()

@router.post("/transactions", response_model=TransactionResponse)
async def create_transaction(request: TransactionRequest):
    try:
        return await fabric_service.submit_transaction(request)
    except Exception as e:
        raise HTTPException(status_code=400, detail=str(e))

@router.get("/transactions/{transaction_id}")
async def get_transaction(transaction_id: str):
    return await fabric_service.get_transaction(transaction_id)
EOF
