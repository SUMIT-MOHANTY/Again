import os
from typing import List

# Load configuration values
from .config import SECRETS_MANAGER, SECRETS_VAULT_NAME

def _get_aws_client():
    import boto3
    return boto3.client("secretsmanager")

def _get_azure_client():
    from azure.identity import DefaultAzureCredential
    from azure.keyvault.secrets import SecretClient
    vault_url = f"https://{SECRETS_VAULT_NAME}.vault.azure.net/"
    credential = DefaultAzureCredential()
    return SecretClient(vault_url=vault_url, credential=credential)

def get_secret(secret_name: str) -> str:
    """
    Retrieve a secret value by its identifier.
    """
    if SECRETS_MANAGER == "aws":
        client = _get_aws_client()
        resp = client.get_secret_value(SecretId=secret_name)
        return resp.get("SecretString", "")
    elif SECRETS_MANAGER == "azure":
        client = _get_azure_client()
        secret = client.get_secret(secret_name)
        return secret.value
    else:
        raise RuntimeError(f"Unsupported secrets manager: {SECRETS_MANAGER}")

def list_secrets() -> List[str]:
    """
    List identifiers of all available secrets.
    """
    if SECRETS_MANAGER == "aws":
        client = _get_aws_client()
        resp = client.list_secrets()
        return [s["Name"] for s in resp.get("SecretList", [])]
    elif SECRETS_MANAGER == "azure":
        client = _get_azure_client()
        return [s.name for s in client.list_properties_of_secrets()]
    else:
        raise RuntimeError(f"Unsupported secrets manager: {SECRETS_MANAGER}")
EOF

