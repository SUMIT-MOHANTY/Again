cat <<'EOF' > frontend/src/components/TransferForm.jsx
import React, { useState } from 'react';
import { useMutation } from '@tanstack/react-query';
import axios from 'axios';

const TransferForm = ({ onSuccess }) => {
  const [formData, setFormData] = useState({
    from_account: '',
    to_account: '',
    amount: '',
    description: ''
  });

  const mutation = useMutation({
    mutationFn: (data) => axios.post('/api/banking/transfer', data),
    onSuccess: () => onSuccess?.()
  });

  const handleSubmit = (e) => {
    e.preventDefault();
    mutation.mutate({ ...formData, amount: parseFloat(formData.amount) });
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-4 max-w-md">
      <div>
        <label htmlFor="from_account" className="block text-sm font-medium">From Account</label>
        <input
          id="from_account"
          type="text"
          className="mt-1 block w-full border rounded-md shadow-sm"
          value={formData.from_account}
          onChange={e => setFormData({ ...formData, from_account: e.target.value })}
          required
          aria-label="From account"
        />
      </div>

      <div>
        <label htmlFor="to_account" className="block text-sm font-medium">To Account</label>
        <input
          id="to_account"
          type="text"
          className="mt-1 block w-full border rounded-md shadow-sm"
          value={formData.to_account}
          onChange={e => setFormData({ ...formData, to_account: e.target.value })}
          required
          aria-label="To account"
        />
      </div>

      <div>
        <label htmlFor="amount" className="block text-sm font-medium">Amount</label>
        <input
          id="amount"
          type="number"
          step="0.01"
          className="mt-1 block w-full border rounded-md shadow-sm"
          value={formData.amount}
          onChange={e => setFormData({ ...formData, amount: e.target.value })}
          required
          aria-label="Transfer amount"
        />
      </div>

      <button
        type="submit"
        disabled={mutation.isPending}
        className="w-full bg-blue-600 text-white px-4 py-2 rounded-md"
      >
        {mutation.isPending ? 'Transferring...' : 'Transfer'}
      </button>

      {mutation.isError && (
        <p className="text-red-600" role="alert">Transfer failed</p>
      )}
    </form>
  );
};

export default TransferForm;
EOF

