import axios from 'axios';

const api = axios.create({
  baseURL: '/api',
  timeout: 5000
});

export interface PolicyEnrollment {
  premium_amount: number;
  interval_months: number;
}

export interface PolicyResponse {
  status: 'success' | 'error';
  data: any;
  trace_id: string;
}

export const enrollPolicy = async (
  user: string,
  body: PolicyEnrollment
): Promise<PolicyResponse> => {
  const res = await api.post(`/policies/${user}`, body);
  return res.data;
};

export const renewPolicy = async (
  policy_id: string
): Promise<PolicyResponse> => {
  const res = await api.patch(`/policies/${policy_id}/renew`);
  return res.data;
};
EOF

