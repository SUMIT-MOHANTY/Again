from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
from datetime import datetime, timedelta
from typing import Optional
from uuid import uuid4
import os

app = FastAPI()

class PolicyEnrollment(BaseModel):
    premium_amount: float
    interval_months: int

class PolicyResponse(BaseModel):
    status: str
    data: dict
    trace_id: str

# Stub cron calculation
def calc_next_premium_date(
    created_at: datetime,
    interval_months: int
) -> datetime:
    return created_at + timedelta(days=30*interval_months)

def publish_ledger_event(
    policy_id: str,
    amount: float,
    next_date: datetime
):
    print(f"[ledger] scheduled premium {amount} for policy {policy_id} at {next_date}")

@app.post("/policies/{user}")
async def enroll_policy(user: str, body: PolicyEnrollment):
    policy_id = str(uuid4())
    next_date = calc_next_premium_date(datetime.utcnow(), body.interval_months)
    
    publish_ledger_event(policy_id, body.premium_amount, next_date)
    
    return PolicyResponse(
        status="success",
        data={
            "policy_id": policy_id,
            "user": user,
            "premium_amount": body.premium_amount,
            "next_premium_date": next_date.isoformat()
        },
        trace_id=str(uuid4())
    )

@app.patch("/policies/{policy_id}/renew")
async def renew_policy(policy_id: str):
    # Stub renewal - recalculates next premium date
    next_date = datetime.utcnow() + timedelta(days=30)
    return PolicyResponse(
        status="success",
        data={
            "policy_id": policy_id,
            "next_premium_date": next_date.isoformat()
        },
        trace_id=str(uuid4())
    )
EOF

