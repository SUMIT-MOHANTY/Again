# [FIX 12] Create frontend service
cat <<'EOF' > frontend/src/services/ledgerService.ts
import axios from 'axios'

const API_BASE = '/ledger'

export interface TransactionResponse {
  transactionId: string
  blockNumber: number
  hash: string
}

export const createTransaction = async (transaction: any): Promise<TransactionResponse> => {
  const response = await axios.post(`${API_BASE}/transactions`, transaction)
  return response.data
}

export const getTransaction = async (transactionId: string) => {
  const response = await axios.get(`${API_BASE}/transactions/${transactionId}`)
  return response.data
}
EOF
