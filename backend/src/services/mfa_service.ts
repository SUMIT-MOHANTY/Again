import * as speakeasy from 'speakeasy';
import { db } from '../db/pool';

export class MFAService {
  static generateSecret(userId: string) {
    const secret = speakeasy.generateSecret({
      name: `CaptivePortal:${userId}`,
      length: 32
    });
    return secret;
  }

  static async storeSecret(userId: string, secret: string) {
    await db.query(
      'UPDATE users SET totp_secret = $1 WHERE id = $2',
      [secret, userId]
    );
  }

  static async verifyToken(userId: string, token: string): Promise<boolean> {
    const result = await db.query(
      'SELECT totp_secret FROM users WHERE id = $1',
      [userId]
    );
    if (!result.rows[0]?.totp_secret) return false;
    
    return speakeasy.totp.verify({
      secret: result.rows[0].totp_secret,
      encoding: 'base32',
      token,
      window: 2
    });
  }
}
EOF

cat <<'EOF' > backend/src/routes/auth.ts
import express from 'express';
import { body, validationResult } from 'express-validator';
import * as bcrypt from 'bcrypt';
import jwt from 'jsonwebtoken';
import { MFAService } from '../services/mfa_service';
import { db } from '../db/pool';

const router = express.Router();

router.post('/login', [
  body('email').isEmail(),
  body('password').isLength({ min: 8 }),
  body('mfa_token').optional().isNumeric()
], async (req, res) => {
  const errors = validationResult(req);
  if (!errors.isEmpty()) {
    return res.status(400).json({ errors: errors.array() });
  }

  const { email, password, mfa_token } = req.body;
  
  const result = await db.query(
    'SELECT id, email, password_hash, totp_enabled FROM users WHERE email = $1',
    [email]
  );

  if (!result.rows[0]) {
    return res.status(401).json({ error: 'Invalid credentials' });
  }

  const user = result.rows[0];
  const isPasswordValid = await bcrypt.compare(password, user.password_hash);

  if (!isPasswordValid) {
    return res.status(401).json({ error: 'Invalid credentials' });
  }

  if (user.totp_enabled && mfa_token) {
    const isMFATokenValid = await MFAService.verifyToken(user.id, mfa_token);
    if (!isMFATokenValid) {
      return res.status(401).json({ error: 'Invalid MFA token' });
    }
  } else if (user.totp_enabled) {
    return res.status(302).json({ error: 'MFA token required' });
  }

  const token = jwt.sign(
    { userId: user.id, email: user.email },
    process.env.JWT_SECRET!,
    { expiresIn: '24h' }
  );

  res.json({ token });
});

router.post('/enable-mfa', async (req, res) => {
  const userId = req.user?.id;
  if (!userId) return res.status(401).json({ error: 'Unauthorized' });

  const secret = MFAService.generateSecret(userId);
  await MFAService.storeSecret(userId, secret.base32);
  await db.query('UPDATE users SET totp_enabled = true WHERE id = $1', [userId]);

  res.json({
    qr_code: secret.otpauth_url,
    secret: secret.base32
  });
});

export default router;
EOF

