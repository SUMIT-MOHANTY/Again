package main

import (
    "log"
    "net/http"
    "github.com/gorilla/mux"
    "go-insur/internal/handler"
    "go-insur/internal/repository"
)

func main() {
    repo := repository.NewPostgresRepository()
    h := handler.NewHandler(repo)

    r := mux.NewRouter()
    
    api := r.PathPrefix("/api/v1").Subrouter()
    api.HandleFunc("/policies", h.GetPolicies).Methods("GET")
    api.HandleFunc("/enroll", h.EnrollPolicy).Methods("POST")

    log.Println("Insurance service starting on :8081")
    log.Fatal(http.ListenAndServe(":8081", r))
}
EOF
[ -f backend/go-insur/cmd/main.go ] && printf "[CHECK] PASS main.go created\n"

# [FIX 3] Create missing handler package files
printf "[FIX 3] Creating handler package files with proper delimiters\n"
cat <<'EOF' > backend/go-insur/internal/handler/policies.go
package handler

import (
    "encoding/json"
    "net/http"
)

type Handler struct {
    repo Repository
}

type Repository interface {
    GetPolicies() ([]PolicyResponse, error)
    CreatePolicy(req EnrollRequest) (*PolicyResponse, error)
}

func NewHandler(repo Repository) *Handler {
    return &Handler{repo: repo}
}

func (h *Handler) GetPolicies(w http.ResponseWriter, r *http.Request) {
    policies, err := h.repo.GetPolicies()
    if err != nil {
        http.Error(w, err.Error(), http.StatusInternalServerError)
        return
    }
    json.NewEncoder(w).Encode(policies)
}

func (h *Handler) EnrollPolicy(w http.ResponseWriter, r *http.Request) {
    var req EnrollRequest
    if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
        http.Error(w, err.Error(), http.StatusBadRequest)
        return
    }
    
    policy, err := h.repo.CreatePolicy(req)
    if err != nil {
        http.Error(w, err.Error(), http.StatusInternalServerError)
        return
    }
    
    w.Header().Set("Content-Type", "application/json")
    w.WriteHeader(http.StatusCreated)
    json.NewEncoder(w).Encode(policy)
}
EOF
